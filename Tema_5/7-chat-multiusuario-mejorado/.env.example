# La clave real debe permanecer fuera de Git.
OPENAI_API_KEY=pega_aqui_tu_clave

# Opcionales: los valores mostrados son los predeterminados del proyecto.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
CHAT_TEMPERATURE=0.2
MAX_MEMORY_RESULTS=5
MAX_INPUT_CHARACTERS=8000

# Protege la vista que cambia el conocimiento compartido por todos los usuarios.
# Usa un valor largo y diferente de la clave de OpenAI.
KNOWLEDGE_ADMIN_PASSWORD=cambia_esta_contrasena

# Ajustes del RAG normativo. MAX_PDF_BYTES equivale por defecto a 20 MB.
MAX_KNOWLEDGE_RESULTS=6
MAX_PDF_BYTES=20971520
MAX_LEGAL_CHUNK_CHARACTERS=6000
